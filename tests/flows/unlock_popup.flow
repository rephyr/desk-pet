# Something new opening up pops up a card (it waits while a box is being opened); "show me" goes
# to its tab. (The workbench no longer opens from a first part before parts are a feature, so
# this uses the basket: errands.)
from no_bag_tab
view full
stickers off                  # new pets here can fill a book page: no sticker popups over the shots
tab boxes
click name:buy_starter
click name:open_starter_1
find basket
key space
wait popup
expect text "new: errands!"
shot popup
click "show me"
expect tab errands
