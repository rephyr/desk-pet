# Every tab and every pet's details stay inside the window, with a crowd of pets and errands going (the scrapyard's
# "a part, sometimes uncommon" line once pushed the errands tab past the edge).
from rich
view full
stickers off                  # the pets here can fill a book page now and then: no sticker popups
pets 9
find basket
wait popup
click "lovely"
tab errands
wait 1
expect fits
shot errands_few
tab home
expect fits
tab boxes
expect fits
tab collection
expect fits
shot bookcase
click MiniCard#1
expect fits
click "‹ shelves"
click MiniCard#2
expect fits
click "‹ shelves"
click MiniCard#3
expect fits
click "‹ shelves"
click MiniCard#4
expect fits
click "‹ shelves"
click MiniCard#5
expect fits
click "‹ shelves"
click MiniCard#6
expect fits
click "‹ shelves"
click ShelfPlank#1
click MiniCard#1
expect fits
click MiniCard#2
expect fits
click MiniCard#3
expect fits
click MiniCard#4
expect fits
shot pets
unlock feature:parts                # knacks: badges on the details and the cards' corners
unlock tab:automation
fix wires
wait 1.5
click MiniCard#1
expect fits
click MiniCard#2
expect fits
click MiniCard#3
expect fits
shot pets_knacks
tab adventures
expect fits
tab inventory
expect fits
tab settings
expect fits
click "video"
expect fits
pets 40
tab errands
wait 1
expect fits
shot errands_many
