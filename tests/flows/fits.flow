# Every tab and every pet's details stay inside the window, with a crowd of pets and errands going (the scrapyard's
# "a part, sometimes uncommon" line once pushed the errands tab past the edge).
from rich
view full
stickers off                  # the pets here can fill a book page now and then: no sticker popups
pets 9 7
find basket
wait popup
click "lovely"
tab errands
wait 1
expect fits
shot errands_few
tab home
expect fits
tab boxes
expect fits
tab collection
expect fits
shot bookcase
click MiniCard#1
expect fits
click "‹ shelves"
click MiniCard#2
expect fits
click "‹ shelves"
click MiniCard#3
expect fits
click "‹ shelves"
click MiniCard#4
expect fits
click "‹ shelves"
click MiniCard#5
expect fits
click "‹ shelves"
click MiniCard#6
expect fits
click "‹ shelves"
click ShelfPlank#1
click MiniCard#1
expect fits
click MiniCard#2
expect fits
click MiniCard#3
expect fits
click MiniCard#4
expect fits
shot pets
unlock feature:parts                # knacks: badges on the details and the cards' corners
unlock tab:automation
fix wires
wait 1.5
click MiniCard#1
expect fits
click MiniCard#2
expect fits
click MiniCard#3
expect fits
shot pets_knacks
tab adventures
expect fits
tab inventory
expect fits
tab settings
expect fits
click "video"
expect fits
pets 40
tab errands
wait 1
expect fits
shot errands_many
herd common normal 20               # the plushie machine: the cabinet and its side card fit, with a pet in and a wild reel
open-plushie
wait popup
click "lovely"
tab inventory
page inventory 2
herd uncommon normal 5
hopper common 2
hopper uncommon 1
wisps 2000
spin                                # the uncommon hops in (two spins)
buy wild
spin
expect fits
shot plushie
dungeon                             # the sewing room: the door on floor 20, the rooms pane, a rolled room
wait popup
click "lovely"
deep 20
wait popup
click "lovely"
find little_key
tab adventures
page adventures 2
wait 1
army best
army-herd common 20
wait 1
expect fits
door
wait 1
expect text "the button tin"
expect fits
sewn 12
sew-room 13
wait 1
expect fits
shot sewing
