# E3 the sewing room, redone in P4 (look A: the seats). Nothing on floor 20 until the tiny key is
# found, then a little pink door. Tap it: the sewing room as its own page (‹ the old well, the
# wisps): the strip of rooms (the button tin picked, the pin cushion as a dashed carrot), the tin's
# card with a seat per chalk mark and the pet picker. "where from? ›" has your pet say where a
# seat's pets come from. Tap a seat, then a pet that fits (the fitting ones come first): one shiny
# rare bunny sits on all three seats; the army walks in behind ("and 250 more"). In we go: the
# clock and the tiny pets, then the result (wisps, came home, again / the pin cushion ›). The first
# clear teaches keep lines; the last room opens the plushie machine (a free button on your pet),
# then rolled rooms with button locks, where your pet can sit too. Everything stays in the window.
from rich
view full
stickers off                  # new pets here can fill a book page: no sticker popups over the shots
herd common normal 3000
herd uncommon normal 900
herd rare normal 200
unlock page:beyond
unlock location:well
unlock feature:new_homes
unlock feature:sorting
dungeon
wait popup
click "lovely"
deep 20
wait popup                           # past floor 10: your pet can lead the army
click "lovely"
card body=fox rarity=epic 6
card body=bear rarity=uncommon 6
tab adventures
page adventures 2
wait 1
army best
army-herd common 150
army-herd rare 100
wait 1
expect text "the old well"
expect no-text "the sewing room"     # the key and its door stay hidden until found
expect fits
shot no_door
find little_key
wait 1
expect fits
shot door
click SewDoor#1
wait 1
expect text "the sewing room"
expect text "‹ the old well"
expect text "the button tin"
expect text "→ the pin cushion"      # the next room, the carrot
expect no-text "the thread maze"     # rooms not reached yet stay hidden
expect text "who's going in"
expect text "bunny ears"
expect text "in we go!"
expect text "more"                   # the army walking in behind
expect fits
shot room
click "where from? ›"                # the bunny ears seat is tapped: where do they come from?
wait 0.5
expect text "bunny ears come on rare pets*"
expect fits
shot where_from
card body=bunny rarity=rare finish=shiny 2
wait 1
click name:SewSeat2                  # the rare seat
wait 0.5
expect text "rare ones"
shot seat_tapped                     # fitting pets first and lit up, the others dim
click name:SewPick1
wait 0.5
expect fits
shot seated                          # one shiny rare bunny sits on all three seats
click "in we go!"
wait 1
expect text "on the way…"
expect fits
shot running
down-done
wait popup                           # the first clear: keep lines
expect text "new: keep lines!"
expect fits
shot keep_popup
click "show me"
wait 1
expect tab collection
expect text "keep"
expect text "nothing"
keep 1 trait:zoomy
wait 1
expect text "zoomy ones"
expect fits
shot keep_lines
# back in the sewing room: the result waits there
tab adventures
wait 1
expect text "the sewing room"
expect text "again"
expect fits
shot result
click "the pin cushion ›"
wait 1
expect text "the pin cushion"
expect text "→ the thread maze"
expect fits
shot next_room
# the last room: it opens the plushie machine and sews a button onto your pet
sewn 8
wait 1
sew-room 9
card accessory=horns body=dragon finish=glitch rarity=mythic trait=lucky
card body=dragon rarity=mythic finish=prismatic trait=brave 19
army best
wait 1
sew-seat all
wait 1
expect text "the sewing basket"
expect fits
shot basket
in
down-done
wait popup
expect text "new: the plushie machine!"
expect fits
shot plushie
click "lovely"
wait 1
tab adventures
wait 1
sew-room 10                          # rolled rooms from here on: a button lock first
wait 1
click name:SewSeat1                  # the button seat: your pet has the free button
wait 0.5
click name:SewPick1
wait 0.5
expect text "1 button"
expect fits
shot rolled
# the army down the well while the sewing room shows: the room's button isn't "on the way…"
down
wait 1
expect text "in we go!"
expect fits
shot well_run_rooms
down-done
wait 1
expect fits
click "‹ the old well"
wait 1
expect text "the old well"
expect no-text "who's going in"
expect fits
shot back_to_well
# three keep lines by now (rooms 1, 4 and 7): they all fit on the sorting card
tab collection
wait 1
keep 2 part:body:bunny
wait 1
expect text "bunny ears"
expect fits
shot keep_three
